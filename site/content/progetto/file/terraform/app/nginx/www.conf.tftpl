# Vhost pubblico in Kubernetes: come docker/config/nginx/local.biodistretto.conf, più le rotte che in docker faceva il proxy di Vite.
server {
    listen 443 ssl proxy_protocol;
    server_name ${dominio} www.${dominio};

    ssl_certificate     /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;

    set_real_ip_from 0.0.0.0/0;
    real_ip_header proxy_protocol;

    set $cors_origin "";
    if ($http_origin ~* ^https://(www\.)?${replace(dominio, ".", "\\.")}$) {
        set $cors_origin $http_origin;
    }

    client_max_body_size 110m;

    set $backend_prefix /backend;

    location ^~ /backend/media/ {
        proxy_pass http://minio:9000/biodistretto/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_buffering off;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        limit_except GET HEAD OPTIONS { deny all; }
    }

    location ^~ /media/ {
        proxy_pass http://minio:9000/biodistretto/;
        proxy_set_header Host $host;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_buffering off;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        limit_except GET HEAD OPTIONS { deny all; }
    }

    location = /backend {
        set $backend_path /;
        include /etc/nginx/backend_prefix.conf;
    }

    location ~ ^/backend(?<backend_path>/.*)$ {
        include /etc/nginx/backend_prefix.conf;
    }

    location ~ ^/(api|up|storage)(/|$) {
        set $backend_prefix "";
        set $backend_path $uri;
        include /etc/nginx/backend_prefix.conf;
    }

    location / {
        auth_basic "Accesso riservato";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://frontend:8080;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    }
}
